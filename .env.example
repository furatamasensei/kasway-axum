# Copy to `.env` and adjust. docker-compose reads this file automatically
# (via the `api` service's env_file); values here override the compose
# defaults. All variables are optional unless noted.

# --- Core ---
# Postgres connection string. Inside compose the host is the `db` service.
DATABASE_URL=postgres://postgres:postgres@db:5432/kasway
# Address the server binds to (host:port).
HOST_PORT=0.0.0.0:8080
# tracing-subscriber env filter, e.g. info, debug, kasway_api=debug.
RUST_LOG=info
# development | production. Gates a few dev-only behaviors.
NODE_ENV=development

# --- App identity / URLs ---
APP_NAME=Kasway
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# --- Auth ---
# Bearer token for /internal/* endpoints. Set a real secret before deploying.
INTERNAL_API_TOKEN=dev-internal-token
# Cloudflare Turnstile secret (bot check); leave unset to disable.
TURNSTILE_SECRET=
# Google OAuth (login callback); leave unset to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Background workers ---
# In-process webhook delivery worker. Default on; set 0/false/off to disable.
WEBHOOK_WORKER_ENABLED=1
# Kaspa node wRPC JSON websocket URL, e.g. ws://<ip>:18210 (TN10 JSON port).
# Chain observer is on only when this is set (unless overridden below).
KASPA_NODE_URL=
CHAIN_OBSERVER_ENABLED=
# Covenant keeper: releases/refunds covenants. Needs KASPA_NODE_URL + fee key.
COVENANT_KEEPER_ENABLED=
COVENANT_KEEPER_FEE_SECRET=
COVENANT_KEEPER_MIN_FEE_SOMPI=
COVENANT_CAPTURE_WINDOW_SECS=

# --- Covenant arbiter (dispute settlement) ---
COVENANT_ARBITER_SECRET=
COVENANT_ARBITER_PANEL=
COVENANT_ARBITER_THRESHOLD=

# --- KPR-1 signing ---
KPR1_SIGNING_SEED=
KPR1_SIGNING_KEY_ID=

# --- Platform fees ---
KASWAY_PLATFORM_FEE_BPS=
KASWAY_PLATFORM_FEE_FLAT_SOMPI=
KASWAY_PLATFORM_FEE_ADDRESS=

# --- Pricing ---
PRICE_API_URL=https://api.coingecko.com/api/v3/simple/price
