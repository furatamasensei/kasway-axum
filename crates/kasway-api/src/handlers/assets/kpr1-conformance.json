    "signedCanonicalJson": "{\"amountSompi\":\"100000000\",\"asset\":\"KAS\",\"display\":{\"currencyCode\":\"KAS\",\"memo\":\"Invoice inv_conformance_0001\"},\"expiresAt\":\"2026-06-01T12:00:00.000Z\",\"intentId\":\"kpr1_conformance_0001\",\"invoiceId\":\"inv_conformance_0001\",\"merchant\":{\"domain\":\"checkout.kasway.test\",\"name\":\"Kasway Conformance Merchant\"},\"network\":\"tn10\",\"outputs\":[{\"address\":\"kaspatest:qmerchantconformance000000000000000000000000000\",\"amountSompi\":\"97000000\",\"role\":\"merchant_net\"},{\"address\":\"kaspatest:qkaswayfeeconformance000000000000000000000000\",\"amountSompi\":\"3000000\",\"role\":\"kasway_fee\"}],\"refund\":{\"addressRequiredFromWallet\":true,\"timeoutSeconds\":1800},\"signature\":{\"alg\":\"ed25519\",\"keyId\":\"kpr1-fixture-ed25519-2026-05\",\"value\":\"uwj9axys0LoLkXmdXVzc0hvllB8BroH8W1FqE5DiSh4NnrbJUKEgi9iISPuyxeIZO34BiWk4gGbj66ZTEoI/Cg==\"},\"template\":{\"id\":\"split_settlement\",\"scriptHash\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"version\":\"v1\"},\"version\":\"kpr-1\"}",
