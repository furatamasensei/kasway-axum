  "extensionPermissionExpectations": {
    "manifestVersion": 3,
    "permissions": ["storage"],
    "hostPermissions": [
      "https://checkout.kasway.test/*",
      "https://api.kasway.test/*",
      "http://localhost:3333/*"
    ],
    "mustNotInclude": ["<all_urls>", "tabs", "debugger", "nativeMessaging", "clipboardRead"],
    "providerApiStatus": "not_supported"
  },
  "extensionStorageExpectations": {
    "namespacePrefix": "tn10:extension-wallet:v1:",
    "encryption": "PBKDF2-HMAC-SHA-256 + AES-GCM",
    "lockDefaults": ["locked_on_startup", "locked_on_service_worker_restart", "lock_on_timeout"],
    "plaintextForbiddenFields": ["seedPhrase", "mnemonic", "privateKey", "xprv", "secretKey"],
    "decryptedMaterialScope": "background_memory_only_while_unlocked"
  },
  "extensionDetectionCases": [
    {
      "name": "clicked_kaspa_payment_v1_anchor",
      "input": "validIntent.qrUri",
      "origin": "https://checkout.kasway.test",
      "userGesture": true,
      "expectedResult": "detected"
    },
    {
      "name": "plain_kaspa_address_ignored",
      "input": "kaspa:kaspatest:qmerchantconformance000000000000000000000000000",
      "origin": "https://checkout.kasway.test",
      "userGesture": true,
      "expectedResult": "ignored"
    },
    {
      "name": "mainnet_request_rejected",
      "input": "qrParserNegativeCases.mainnet_rejected_for_mvp.uri",
      "origin": "https://checkout.kasway.test",
      "userGesture": true,
      "expectedFailureReason": "unsupported_network"
    },
    {
      "name": "wrong_origin_post_message_rejected",
      "input": "validIntent.qrUri",
      "origin": "https://evil.example",
      "userGesture": true,
      "expectedFailureReason": "untrusted_origin"
    }
  ],
  "extensionBuildExpectations": {
    "wxtVersion": "0.19.x",
    "manifestTarget": "chrome-mv3",
    "zipRequired": true,
    "realKaspaWasmEnabled": false,
    "manualSmokeRequiredBeforeRelease": true,
    "validatedCommands": [
      "pnpm typecheck",
      "pnpm test",
      "pnpm test:conformance",
      "pnpm build",
      "pnpm zip"
    ]
  }
