      "uri": "kaspa-payment:v1?request=http%3A%2F%2Fcheckout.kasway.test%2Fapi%2Fcheckout%2Finvoices%2Finv_conformance_0001%2Fkpr1-intent&hash=2cee12bf9dfdfcc2eee5047ee12539c36e7f47ae42da0d025f8f62f0b0b137aa&network=tn10&expires=1780315200",
      "expectedFailureReason": "request_url_must_be_https"
