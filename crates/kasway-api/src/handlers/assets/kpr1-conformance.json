  "extensionMessageBoundaryCases": [
    {
      "name": "valid_user_gesture_open_request",
      "channel": "kasway:kpr1",
      "type": "KPR1_OPEN_REQUEST",
      "origin": "https://checkout.kasway.test",
      "userGesture": true,
      "expectedResult": "accepted"
    },
    {
      "name": "untrusted_origin_rejected",
      "channel": "kasway:kpr1",
      "type": "KPR1_OPEN_REQUEST",
      "origin": "https://evil.example",
      "userGesture": true,
      "expectedFailureReason": "untrusted_origin"
    },
    {
      "name": "raw_sign_request_rejected",
      "channel": "kasway:kpr1",
      "type": "RAW_SIGN_TRANSACTION",
      "origin": "https://checkout.kasway.test",
      "userGesture": true,
      "expectedFailureReason": "unsupported_message_type"
    },
    {
      "name": "missing_user_gesture_rejected",
      "channel": "kasway:kpr1",
      "type": "KPR1_OPEN_REQUEST",
      "origin": "https://checkout.kasway.test",
      "userGesture": false,
      "expectedFailureReason": "missing_user_gesture"
    },
    {
      "name": "replayed_approval_nonce_rejected",
      "type": "APPROVE_KPR1_PAYMENT",
      "sessionId": "approval_session_001",
      "displayNonce": "already_used_nonce",
      "expectedFailureReason": "replayed_approval"
    }
