  "verifierNegativeCases": [
    {
      "name": "intent_expired",
      "mutate": { "expiresAt": "2020-01-01T00:00:00.000Z" },
      "expectedFailureReason": "intent_expired"
    },
    {
      "name": "network_or_asset_mismatch",
      "mutate": { "network": "mainnet" },
      "expectedFailureReason": "network_or_asset_mismatch"
    },
    {
      "name": "amount_mismatch",
      "observedAmountSompi": "99999999",
      "expectedFailureReason": "amount_mismatch"
    },
    {
      "name": "tx_id_mismatch",
      "submittedTxId": "kpr1_conformance_tx",
