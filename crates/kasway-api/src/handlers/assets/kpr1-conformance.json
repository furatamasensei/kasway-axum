  "signatureVerificationExamples": [
    {
      "name": "valid_signature",
      "canonicalPayload": "validIntent.unsignedCanonicalJson",
      "signature": "validIntent.intent.signature.value",
      "publicKey": "keys.publicKeyPem",
      "expectedValid": true
    },
    {
      "name": "wrong_public_key",
      "canonicalPayload": "validIntent.unsignedCanonicalJson",
      "signature": "validIntent.intent.signature.value",
      "publicKey": "keys.wrongPublicKeyPem",
      "expectedValid": false
    },
    {
      "name": "tampered_amount_after_signing",
      "tamperedField": "amountSompi",
      "tamperedValue": "100000001",
      "expectedTamperedHash": "9e0d9134d15fb4bf12215ad1c1108227bb9250f18568523e47e162669925a396",
      "expectedValid": false
    }
  ],
  "qrParserNegativeCases": [
    {
      "name": "wrong_scheme",
      "uri": "kaspa:kaspatest:qmerchantconformance000000000000000000000000000?amount=1",
      "expectedFailureReason": "unsupported_scheme"
    },
    {
      "name": "missing_hash",
      "uri": "kaspa-payment:v1?request=https%3A%2F%2Fcheckout.kasway.test%2Fapi%2Fcheckout%2Finvoices%2Finv_conformance_0001%2Fkpr1-intent&network=tn10&expires=1780315200",
      "expectedFailureReason": "missing_hash"
    },
    {
